{
  "Logging": {
    "ApplicationInsights": {
      "LogLevel": {
        "Default": "Information"
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Agents.Authentication.Msal": "Warning",
      "Microsoft.Identity": "Warning"
    }
  },
  "ApplicationInsights": {
  },
  "DetailedErrors": true,
  "AllowedHosts": "*",
  "AzureOpenAIEndpoint": "",
  "ModelDeployment": "gpt-5-chat",
  // Tool source: "Manifest" (ToolingManifest.json), "API" (agent365 discovery), or
  // "Toolbox" (ONLY the Foundry toolbox MCP proxy). When ToolboxName is set and the source is
  // Manifest/API, the toolbox is ATTACHED alongside those tools (hybrid) — the agent keeps its
  // WorkIQ tools and gains the toolbox tools on top.
  "McpDiscoverySource": "Manifest",
  // Foundry project endpoint, e.g. https://<account>.services.ai.azure.com/api/projects/<project>.
  // Needed whenever ToolboxName is set; falls back to the FOUNDRY_PROJECT_ENDPOINT env var.
  "FoundryProjectEndpoint": "",
  // Name of the Foundry toolbox to attach. Empty = no toolbox.
  // A toolbox is a per-project resource: it must exist in THIS project. When empty, the
  // agent attaches no toolbox AND the instructions omit the toolbox tool section, so it
  // never advertises tools it does not have.
  //
  // Deliberately EMPTY in this sample. This is the A2A arm: delegation must go over the A2A
  // surface via the local Work IQ A2A tools, and nothing else. The project toolbox
  // "autopilotroutera2a-workiq" bundles a `workiq` MCP tool whose `ask` accepts an optional
  // agentId, which gives the model a second, MCP-based way to reach another agent. Measured:
  // with the toolbox attached the model chose workiq___ask over the A2A tools and never
  // touched A2A at all, so the arm was not testing what it claimed to test. The toolbox is
  // not needed here — the local handler does discovery AND invocation over direct HTTP.
  // The MCP arm (foundry-autopilot-router-agent) is where the MCP invoke path belongs.
  "ToolboxName": "",
  // Optional toolbox version pin (e.g. "1"). Empty = latest (the toolbox's default version).
  // Pin this once a toolbox exists in THIS project. Pinning matters: the unpinned endpoint
  // serves whatever the default version is, so publishing a toolbox version silently changes
  // what every running instance loads. A version whose tools cannot be resolved makes
  // tools/list fail wholesale, which the Responses API reports as external_connector_error and
  // which surfaces as BadRequest on every turn.
  // Keep toolboxes to plain `mcp` tools: a2a_preview / work_iq_preview connections using
  // AgenticIdentityToken cannot be resolved by the toolbox MCP proxy on an MCP call. For Work
  // IQ, use a RemoteTool connection to https://workiq.svc.cloud.microsoft/mcp with audience
  // fdcc1f02-fc51-4226-8753-f668596af7f7 (the app id GUID, NOT the api:// form), and grant the
  // blueprint delegated WorkIQAgent.Ask for that audience.
  "ToolboxVersion": "8",
  // Scope for the agent-user token presented to the toolbox MCP proxy. Empty = the Foundry
  // data-plane default (https://ai.azure.com/.default). Configurable while toolbox auth is in preview.
  "ToolboxAccessTokenScope": "",
  // Value for the toolbox proxy's preview feature-flag header. Empty = "Toolboxes=V1Preview"
  // (or the platform-injected FOUNDRY_AGENT_TOOLBOX_FEATURES).
  "ToolboxFeaturesHeader": "",
  "DirectMessageAllowListTableConnectionString": "",
  "DirectMessageAllowListTableServiceUri": "",
  "DirectMessageAllowListTableName": "digitalworkerallowlist",
  "DirectMessageAllowListManagedIdentityClientId": "",
  "GroupChatUnauthorizedResponse": "I can only respond in this group chat when every participant has been approved by {Manager}. Missing approvals for: {UnauthorizedParticipants}.",
  "CrossTenantUnauthorizedResponse": "I'm unable to respond to requests from outside my organization.",
  "EnableStreamingUpdates": false,
  // The Responses API validates every attached MCP server before it runs the model, so one
  // unreachable tool source fails the whole turn with external_connector_error. When true, the
  // agent preflights the attached servers on that failure, drops the ones that definitively fail,
  // and retries once - so a broken tool source degrades the agent instead of disabling it.
  "EnableMcpConnectorRecovery": true,
  // How long a server that failed the preflight is skipped before it is tried again.
  "McpQuarantineSeconds": 300,
  // Per-server budget for the preflight handshake (initialize + tools/list).
  "McpHealthProbeTimeoutSeconds": 20,
  "EnableLlmAddressedToAgentJudge": true,
  // Cost/latency tuning for the group-chat YES/NO judge: set to a small/fast deployment
  // available on your AzureOpenAIEndpoint (e.g. a mini model). Empty = use ModelDeployment.
  "AddressedToAgentJudgeModelDeployment": "",
  "AgentDisplayNameAliases": "",
  "EnablePassiveWorkItemDetection": true,
  // Agent-to-agent delegation via the Work IQ MCP `ask` tool, at
  // https://workiq.svc.cloud.microsoft/mcp with audience fdcc1f02-fc51-4226-8753-f668596af7f7 —
  // the same audience the A2A discovery calls use, so one credential covers both.
  // Set this to the M365 agent ID of the Source of Truth agent as it appears in THIS agent
  // instance's "My agents" list. Empty = no delegation section in the instructions.
  //
  // Do NOT re-add mcp_M365Copilot to ToolingManifest.json. Its copilot_chat tool accepts an
  // agentId, but measured 18 Aug 2026 it does not route to that agent: Copilot answers the
  // question itself, for Copilot Studio and Foundry targets alike, and no field in the response
  // reveals the target was never reached. Foundry telemetry showed zero invoke_agent entries for
  // four consecutive calls on that path. It was removed from the manifest so the model cannot
  // reach it at all — an instruction not to use it was not enough of a guarantee.
  "SourceOfTruthAgentId": "",
  // Display name used when referring to the delegate agent in instructions.
  "SourceOfTruthAgentName": "Source of Truth",
  "AgentConfiguration": {
  },
  "AgentApplication": {
    "StartTypingTimer": false,
    "RemoveRecipientMention": false,
    "NormalizeMentions": false,
    "UserAuthorization": {
      "AutoSignin": false,
      "Handlers": {
        "agentic": {
          "Type": "AgenticUserAuthorization",
          "Settings": {
            "AlternateBlueprintConnectionName": "AgentBluePrint"
          }
        }
      }
    }
  },
  "Connections": {
    "ServiceConnection": {
      "Settings": {
        "AuthType": "UserManagedIdentity",
        "EnableContainerIMDS": true,
        // Blueprint Client ID
        "ClientId": "",
        // https://login.microsoftonline.com/{{BOT_TENANT_ID}}
        "AuthorityEndpoint": "https://login.microsoftonline.com/{{BOT_TENANT_ID}}",
        "Scopes": [
          // APX scope.
          "5a807f24-c9de-44ee-a3a7-329e88a00ffc/.default"
        ]
      }
    }
  },
  "ConnectionsMap": [
    {
      "ServiceUrl": "*",
      "Connection": "ServiceConnection"
    }
  ],
  "ProjectDefaultInstanceClientId": "",
  "MSALConfiguration": {
    "MSALEnabledLogPII": false
  },
  "A365AgentTracingId": "",
  "WorkItemsTableServiceUri": "",
  "WorkItemsTableName": "workitems",
  // Durable per-conversation Responses API chain state. Defaults to the work-items table
  // account (same lifetime, same per-instance RBAC grant) with its own table. Leave the URI
  // empty to inherit WorkItemsTableServiceUri. When neither is set the agent falls back to
  // container-local files, and conversation continuity does not survive a container restart.
  "ConversationStateTableServiceUri": "",
  "ConversationStateTableName": "conversationstate"
}





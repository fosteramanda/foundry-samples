{
  "Logging": {
    "ApplicationInsights": {
      "LogLevel": {
        "Default": "Information"
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Agents.Authentication.Msal": "Warning",
      "Microsoft.Identity": "Warning"
    }
  },
  "ApplicationInsights": {
  },
  "DetailedErrors": true,
  "AllowedHosts": "*",
  "AzureOpenAIEndpoint": "",
  "ModelDeployment": "gpt-5-chat",
  // Tool source: "Manifest" (ToolingManifest.json), "API" (agent365 discovery), or
  // "Toolbox" (ONLY the Foundry toolbox MCP proxy). When ToolboxName is set and the source is
  // Manifest/API, the toolbox is ATTACHED alongside those tools (hybrid) — the agent keeps its
  // WorkIQ tools and gains the toolbox tools on top.
  "McpDiscoverySource": "Manifest",
  // Foundry project endpoint, e.g. https://<account>.services.ai.azure.com/api/projects/<project>.
  // Needed whenever ToolboxName is set; falls back to the FOUNDRY_PROJECT_ENDPOINT env var.
  "FoundryProjectEndpoint": "https://foundryworkstreammangeracct.services.ai.azure.com/api/projects/foundryworkstreammangerproj",
  // Name of the Foundry toolbox to attach. Empty = no toolbox.
  "ToolboxName": "workstream-manager-ado",
  // Optional toolbox version pin (e.g. "1"). Empty = latest version.
  "ToolboxVersion": "",
  // Scope for the agent-user token presented to the toolbox MCP proxy. Empty = the Foundry
  // data-plane default (https://ai.azure.com/.default). Configurable while toolbox auth is in preview.
  "ToolboxAccessTokenScope": "",
  // Value for the toolbox proxy's preview feature-flag header. Empty = "Toolboxes=V1Preview"
  // (or the platform-injected FOUNDRY_AGENT_TOOLBOX_FEATURES).
  "ToolboxFeaturesHeader": "",
  "DirectMessageAllowListTableConnectionString": "",
  "DirectMessageAllowListTableServiceUri": "",
  "DirectMessageAllowListTableName": "digitalworkerallowlist",
  "DirectMessageAllowListManagedIdentityClientId": "",
  "GroupChatUnauthorizedResponse": "I can only respond in this group chat when every participant has been approved by {Manager}. Missing approvals for: {UnauthorizedParticipants}.",
  "CrossTenantUnauthorizedResponse": "I'm unable to respond to requests from outside my organization.",
  "EnableStreamingUpdates": false,
  "EnableLlmAddressedToAgentJudge": true,
  // Cost/latency tuning for the group-chat YES/NO judge: set to a small/fast deployment
  // available on your AzureOpenAIEndpoint (e.g. a mini model). Empty = use ModelDeployment.
  "AddressedToAgentJudgeModelDeployment": "",
  "AgentDisplayNameAliases": "",
  "EnablePassiveWorkItemDetection": true,
  "AgentConfiguration": {
  },
  "AgentApplication": {
    "StartTypingTimer": false,
    "RemoveRecipientMention": false,
    "NormalizeMentions": false,
    "UserAuthorization": {
      "AutoSignin": false,
      "Handlers": {
        "agentic": {
          "Type": "AgenticUserAuthorization",
          "Settings": {
            "AlternateBlueprintConnectionName": "AgentBluePrint"
          }
        }
      }
    }
  },
  "Connections": {
    "ServiceConnection": {
      "Settings": {
        "AuthType": "UserManagedIdentity",
        "EnableContainerIMDS": true,
        // Blueprint Client ID
        "ClientId": "",
        // https://login.microsoftonline.com/{{BOT_TENANT_ID}}
        "AuthorityEndpoint": "https://login.microsoftonline.com/{{BOT_TENANT_ID}}",
        "Scopes": [
          // APX scope.
          "5a807f24-c9de-44ee-a3a7-329e88a00ffc/.default"
        ]
      }
    }
  },
  "ConnectionsMap": [
    {
      "ServiceUrl": "*",
      "Connection": "ServiceConnection"
    }
  ],
  "ProjectDefaultInstanceClientId": "",
  "MSALConfiguration": {
    "MSALEnabledLogPII": false
  },
  "A365AgentTracingId": "",
  "WorkItemsTableServiceUri": "",
  "WorkItemsTableName": "workitems"
}

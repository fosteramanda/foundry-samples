# Foundry project (from your 40-basic-agent-setup / infra deployment)
AZURE_AI_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4

# The sample OWNS its toolbox + connection: `provision_skills.py` creates a toolbox named
# "workspace-tools" and an agent-identity (AgenticIdentityToken) connection
# "workspace-tools-toolbox" that fronts its MCP endpoint. The connection id is derived from
# PROJECT_RESOURCE_ID (below) — nothing to set.

# The shared "project drive": a blob container in YOUR storage account (same tenant). BOTH
# agent identities are granted "Storage Blob Data Contributor" on it (see notebook Step 3).
# Seed it once with the contents of ./data (see data/README.md).
AZURE_STORAGE_ACCOUNT=<storageaccountname>
WORKSPACE_CONTAINER=<container>

# Resource IDs used by the notebook's RBAC step (Step 3).
# PROJECT_RESOURCE_ID is required early (provision_skills.py derives the toolbox connection id
# from it, and agent creation references that connection). STORAGE_RESOURCE_ID scopes the
# "Storage Blob Data Contributor" grant to the agent identities. `az resource show`/portal give
# these.
PROJECT_RESOURCE_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<account>/projects/<project>
STORAGE_RESOURCE_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.Storage/storageAccounts/<account>

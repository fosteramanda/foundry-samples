# Your Foundry model. The Copilot SDK talks to it over the Responses wire API
# using a Managed Identity bearer token. Both are auto-injected when deployed as
# a hosted agent; set them here only for local runs (`python main.py`).
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5-mini

# Deployment used by the search_web tool (Foundry built-in web search).
SEARCH_MODEL_DEPLOYMENT_NAME=gpt-4o

# Local runs only: give the Copilot runtime its own config folder so it does not
# load your personal Copilot setup (MCP servers, custom instructions).
# COPILOT_HOME=./.copilot-home

LOG_LEVEL=INFO
